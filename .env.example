# === App ===
DEBUG=true
AUTH_ENABLED=false

# === LLM Provider ===
# Options: gemini | huggingface | ollama | custom
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

# === Google Gemini ===
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# === HuggingFace ===
HF_TOKEN=your_hf_token_here
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# === Ollama (local) ===
OLLAMA_MODEL=llama3.1

# === Custom API (any OpenAI-compatible endpoint) ===
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# === Embedding ===
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === Vector Store (Qdrant) ===
# Local Docker: QDRANT_URL=http://localhost:6333, leave QDRANT_API_KEY empty
# Qdrant Cloud: set both QDRANT_URL and QDRANT_API_KEY
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=edunary_docs

# === MongoDB (Chat History) ===
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGO_DB_NAME=chatbot
MONGO_COLLECTION_NAME=chat_sessions

# === Edunary Backend API ===
BACKEND_API_BASE_URL=https://edunary.runasp.net
BACKEND_API_TIMEOUT=30

# === Auth (JWT from .NET Backend) ===
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# === Cloudflare Worker ===
CF_WORKER_URL=
CF_API_KEY=
# Cloudflare embedding model (used when EMBEDDING_PROVIDER=cloudflare)
# Options: @cf/baai/bge-small-en-v1.5 (384-dim), @cf/baai/bge-base-en-v1.5 (768-dim), @cf/baai/bge-large-en-v1.5 (1024-dim)
CF_BASE_URL=
CF_API_KEY=
CF_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5

OPENAI_KEY= 
STT_MODEL=
